<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>top.zff06</groupId>
        <artifactId>backend-learning</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>11-test</artifactId>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jacoco.version>0.8.13</jacoco.version>
    </properties>

    <dependencies>
        <!--
          教程 3.3：spring-boot-starter-test 一次带进 JUnit 5 / Mockito / AssertJ / JsonPath / Hamcrest。
          父 POM 已经通过 spring-boot-starter-webmvc-test 引入（Boot 4 的等价物），这里显式声明一次，
          让模块自己说清楚测试依赖来自哪，版本仍由父 POM 的 dependencyManagement 管理。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 校验注解：@NotNull / @DecimalMin / @Min，Controller 上的 @Valid 靠它生效 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 覆盖率报告：mvn test 之后看 target/site/jacoco/index.html -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <!--
                      教程 9.3：TestApplication 里 main 方法的 SpringApplication.run(...)
                      测试永远调不到（由 Maven 插件或 java -jar 调用），排除掉它统计才准。
                    -->
                    <excludes>
                        <exclude>top/zff06/test/TestApplication.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <!-- 1. 给 surefire 的 JVM 挂 agent，运行时记录哪些行被执行过 -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <!-- 2. 把 .exec 二进制记录读出来，生成 HTML / CSV / XML 报告 -->
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
